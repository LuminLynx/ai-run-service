# API Settings
API_TITLE="AI Run Service"
API_VERSION="0.1.0"
API_DESCRIPTION="AI-powered service orchestrator for automated development workflows"
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Settings
CORS_ORIGINS=["*"]
CORS_CREDENTIALS=true
CORS_METHODS=["*"]
